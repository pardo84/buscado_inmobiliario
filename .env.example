# Token del Bot de Telegram (Obtenlo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# IDs de administradores o usuarios autorizados (opcional, separados por coma, ej: 123456789,987654321)
ADMIN_USER_IDS=

# Ruta de la base de datos SQLite (por defecto: data/database.sqlite)
DB_PATH=data/database.sqlite

# Nivel de log: debug, info, warn, error
LOG_LEVEL=info

# Intervalo por defecto para escaneo de rutinas (en minutos)
DEFAULT_CHECK_INTERVAL_MINUTES=30

# Intervalo para comprobación de inmuebles en seguimiento (bajadas de precio y retirada)
TRACKING_CHECK_INTERVAL_MINUTES=30

# Timeout de peticiones de scraping en milisegundos
SCRAPER_TIMEOUT_MS=15000
